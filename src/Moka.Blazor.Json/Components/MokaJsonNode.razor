@namespace Moka.Blazor.Json.Components

<div id="@ElementId"
     class="@CssClass"
     @onclick="HandleClick"
     @onclick:stopPropagation="true"
     @oncontextmenu="HandleContextMenu"
     @oncontextmenu:preventDefault="true"
     @ondblclick="HandleDoubleClick">

	@if (ShowLineNumbers)
	{
		<span class="moka-json-line-number">@(Node.Id + 1)</span>
	}

	@* Indentation *@
	<span class="moka-json-node-indent" style="width: @(Node.Depth * 20)px"></span>

	@if (Node.IsRangeGroup)
	{
		<button class="moka-json-node-toggle @ToggleSizeCss"
		        @onclick="HandleToggle"
		        @onclick:stopPropagation="true"
		        title="@(Node.IsExpanded ? "Collapse" : "Expand")">
			@ToggleChar
		</button>
		<span class="moka-json-range">@($"[{Node.RangeStart:N0} ... {Node.RangeStart + Node.ChildCount - 1:N0}]")</span>
	}
	else if (Node.IsClosingBracket)
	{
		@* Closing bracket row *@
		<span class="moka-json-node-toggle-placeholder @ToggleSizeCss"></span>
		<span class="moka-json-bracket">@(Node.ValueKind == JsonValueKind.Object ? "}" : "]")</span>
		@if (Node.HasTrailingComma)
		{
			<span class="moka-json-comma">,</span>
		}
	}
	else
	{
		@* Toggle button or placeholder *@
		@if (Node.ValueKind is JsonValueKind.Object or JsonValueKind.Array)
		{
			<button class="moka-json-node-toggle @ToggleSizeCss"
			        @onclick="HandleToggle"
			        @onclick:stopPropagation="true"
			        title="@(Node.IsExpanded ? "Collapse" : "Expand")">
				@ToggleChar
			</button>
		}
		else
		{
			<span class="moka-json-node-toggle-placeholder @ToggleSizeCss"></span>
		}

		<span class="moka-json-node-content">
		@* Property key *@
		@if (IsEditingKey)
		{
			<input id="@EditInputId"
			       class="moka-json-inline-edit"
			       type="text"
			       value="@EditState!.CurrentValue"
			       @oninput="HandleEditInput"
			       @onkeydown="HandleEditKeyDown"
			       @onblur="HandleEditBlur"
			       @onkeydown:stopPropagation="true"/>
			@if (EditState!.ValidationError is not null)
			{
				<span class="moka-json-inline-edit-error">@EditState.ValidationError</span>
			}
		}
		else if (Node.PropertyName is not null)
		{
			<span class="moka-json-key">@Node.PropertyName</span>
		}
		else if (Node.ArrayIndex >= 0)
		{
			<span class="moka-json-key" style="color: var(--moka-json-color-number)">@Node.ArrayIndex</span>
		}

		@* Value or container opening *@
		@if (Node.ValueKind is JsonValueKind.Object or JsonValueKind.Array)
		{
			<span class="moka-json-bracket">@(Node.ValueKind == JsonValueKind.Object ? "{" : "[")</span>
			@if (!Node.IsExpanded)
			{
				@if (ShowChildCount)
				{
					<span class="moka-json-collapsed-preview">@GetCollapsedPreview()</span>
				}

				<span class="moka-json-bracket">@(Node.ValueKind == JsonValueKind.Object ? "}" : "]")</span>
				@if (Node.HasTrailingComma)
				{
					<span class="moka-json-comma">,</span>
				}
			}
		}
		else if (IsEditingValue)
		{
			@if (Node.ValueKind is JsonValueKind.True or JsonValueKind.False)
			{
				<select class="moka-json-inline-edit-select"
				        value="@EditState!.CurrentValue"
				        @onchange="HandleBoolSelect">
					<option value="true">true</option>
					<option value="false">false</option>
				</select>
			}
			else
			{
				<input id="@EditInputId"
				       class="moka-json-inline-edit @(EditState!.ValidationError is not null ? "moka-json-inline-edit--error" : "")"
				       type="text"
				       value="@EditState!.CurrentValue"
				       @oninput="HandleEditInput"
				       @onkeydown="HandleEditKeyDown"
				       @onblur="HandleEditBlur"
				       @onkeydown:stopPropagation="true"/>
			}

			@if (EditState!.ValidationError is not null)
			{
				<span class="moka-json-inline-edit-error">@EditState.ValidationError</span>
			}

			@if (Node.HasTrailingComma)
			{
				<span class="moka-json-comma">,</span>
			}
		}
		else
		{
			<span class="@ValueCssClass">@DisplayValue</span>
			@if (HiddenCharacters > 0)
			{
				<span class="moka-json-value-more">@($"... {HiddenCharacters:N0} more characters")</span>
			}

			@if (Node.HasTrailingComma)
			{
				<span class="moka-json-comma">,</span>
			}
		}
		</span>
	}
</div>
