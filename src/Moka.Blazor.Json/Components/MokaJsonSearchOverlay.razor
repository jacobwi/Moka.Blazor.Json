@namespace Moka.Blazor.Json.Components

<div class="moka-json-search">
	<input type="text"
	       placeholder="Search..."
	       value="@Query"
	       @oninput="HandleInput"
	       @onkeydown="HandleKeyDown"
	       @onkeydown:stopPropagation="true"
	       aria-label="Search"
	       id="@InputId"/>

	<label style="font-size: 11px; display: flex; align-items: center; gap: 2px;">
		<input type="checkbox" checked="@CaseSensitive" @onchange="HandleCaseSensitiveChange"/>
		Aa
	</label>

	<label style="font-size: 11px; display: flex; align-items: center; gap: 2px;">
		<input type="checkbox" checked="@UseRegex" @onchange="HandleRegexChange"/>
		.*
	</label>

	<span class="moka-json-search-info">
		@if (IsPending && !string.IsNullOrEmpty(Query))
		{
			<span>Searching...</span>
		}
		else if (MatchCount > 0)
		{
			@($"{ActiveMatchIndex + 1} of {MatchCount}")
		}
		else if (!string.IsNullOrEmpty(Query))
		{
			<span>No matches</span>
		}
	</span>

	<button @onclick="OnPrevious" title="Previous (Shift+Enter, Shift+F3, Up)" disabled="@(MatchCount == 0 && !IsPending)">&#x25B2;</button>
	<button @onclick="OnNext" title="Next (Enter, F3, Down)" disabled="@(MatchCount == 0 && !IsPending)">&#x25BC;</button>
	<button @onclick="OnClose" title="Close (Esc)">&#x2715;</button>
</div>
